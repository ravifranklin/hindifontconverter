# Contact configuration placeholders only. Never put real secrets in this file.
# Runtime Cloudflare Worker secrets (use ignored .dev.vars for local placeholders):
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Server-side recipient configuration:
CONTACT_RECIPIENT_EMAIL=
# Public key from a Turnstile widget configured in Managed mode:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CONTACT_RATE_LIMITER is an object binding, not an environment string.
# See README for the proposed 5 attempts/60 seconds Cloudflare binding.
